# ============================================================================
# Mitfahrer-Matching 40C3 – Konfiguration
# Kopieren:  cp .env.example .env     (oder:  make env  – erzeugt Zufalls-Secrets)
# Nichts Geheimes gehört in diese Datei; echte Werte nur in .env (nicht im Git).
# ============================================================================

# --- Allgemein --------------------------------------------------------------
COMPOSE_PROJECT_NAME=mitfahrer
# development | production | test
# In "production" verweigert die API den Start, solange Secrets noch CHANGE_ME enthalten.
APP_ENV=production

# --- Event (TODO: Platzhalter! Ort und Datum des 40C3 stehen noch nicht fest) --
EVENT_NAME=40C3
# TODO: Platzhalterkoordinaten Hamburg CCH (ungefähr) – durch echte Location ersetzen
EVENT_LAT=53.5615
EVENT_LON=9.9885
# TODO: Platzhalterdaten, unbestätigt. Retention rechnet ab EVENT_END_DATE.
EVENT_START_DATE=2026-12-27
EVENT_END_DATE=2026-12-30
RETENTION_DAYS_AFTER_EVENT=14

# --- Datenbank (PostgreSQL 16 + PostGIS) ------------------------------------
# Passwort bitte als Hex erzeugen:  openssl rand -hex 24
POSTGRES_DB=mitfahrer
POSTGRES_USER=mitfahrer
POSTGRES_PASSWORD=CHANGE_ME
# postgis/postgis hat NUR amd64-Images (passt für die Proxmox-VM).
# Auf arm64 (z. B. Apple Silicon) stattdessen:  imresamu/postgis:16-3.5-bookworm
POSTGIS_IMAGE=postgis/postgis:16-3.5
# Auf dem Host nur an localhost gebunden (für Tests/psql). Bewusst NICHT 5432: dort läuft
# auf vielen Hosts schon ein anderer Postgres, und die Tests legen Datenbanken an und löschen sie.
DB_PORT=55432

# --- Routing (OSRM, Profil car) ---------------------------------------------
OSRM_VERSION=v26.4.0
# Geofabrik-Extrakt. Standard: ganz Deutschland (PBF ≈ 4,9 GB; Vorbereitung braucht VIEL RAM,
# siehe README/PLAN.md). Für Entwicklung/Tests:
#   OSRM_PBF_URL=https://download.geofabrik.de/europe/germany/hamburg-latest.osm.pbf
OSRM_PBF_URL=https://download.geofabrik.de/europe/germany-latest.osm.pbf
OSRM_DATA_DIR=./data/osrm
# Host-Port (nur localhost) für Live-Tests; bewusst nicht 5000 (macOS AirPlay)
OSRM_PORT=55000
OSRM_TIMEOUT_S=5

# --- Matching ---------------------------------------------------------------
MATCH_PREFILTER_RADIUS_M=20000
MATCH_MAX_DETOUR_RATIO=0.20
MATCH_MAX_DETOUR_MINUTES=25
# any = ein Kriterium genügt (wörtliche Lesart), all = beide müssen erfüllt sein
MATCH_DETOUR_MODE=any
MATCH_MAX_CANDIDATES=30
MATCH_MAX_SNAP_DISTANCE_M=500
# Datenschutz: In Trefferlisten wird der Anfang der Fahrerroute (Meter) abgeschnitten, damit die
# genaue Startposition (oft die Wohnung) nicht an Fremde geht. 0 = nicht kürzen.
MATCH_ROUTE_TRIM_START_M=1000

# --- Karte ------------------------------------------------------------------
# Der öffentliche OSM-Tile-Server ist NUR für Entwicklung gedacht (Tile Usage Policy!).
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER=none

# --- Auth (ab Phase 2) -------------------------------------------------------
# Erzeugen:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=720
# Für lokales HTTP-Testen auf false stellen; in Produktion true.
COOKIE_SECURE=true
# Komma-getrennte Proxy-IPs/CIDRs, denen X-Forwarded-For geglaubt wird. NUR die feste Adresse des
# Proxys eintragen (eine /32), nie ein ganzes Docker-/LAN-Netz: Jeder Host darin könnte sonst seine
# Client-Adresse fälschen und das Rate-Limit umgehen. Leer = kein Proxy (Peer-Adresse zählt).
#   * Mit dem mitgelieferten Caddy (Profil "proxy", s. u.): docker-compose.proxy.yml setzt den Wert
#     selbst auf die feste Caddy-Adresse (CADDY_IPV4) - hier leer lassen.
#   * Mit Rand-Proxy auf einem anderen Gast (deploy/hel/): dessen Adresse, dort 10.10.10.70.
TRUSTED_PROXIES=
# Komma-getrennte erlaubte Origins für Schreibzugriffe (zusätzlich zu SameSite=Strict).
# Leer: wird aus DOMAIN abgeleitet (https://DOMAIN bzw. http:// bei COOKIE_SECURE=false).
ALLOWED_ORIGINS=

# --- Rate-Limits (in-memory, ein Worker; siehe PLAN.md) -----------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_MATCH_PER_MIN=20
# Zusätzlich zum IP-Limit (Wechsel der Adresse umgeht sie nicht):
#   Login je normalisierter E-Mail (jeder Versuch zählt, auch bei unbekanntem Konto; Grenze: wer die
#   Adresse kennt, kann dieses Konto minutenweise für Logins sperren - bewusst hingenommen)
RATE_LIMIT_LOGIN_PER_EMAIL_PER_MIN=5
#   je angemeldetem Nutzer: /api/match pro Minute, Fahrt anlegen und Anfrage senden pro Stunde
RATE_LIMIT_MATCH_USER_PER_MIN=20
RATE_LIMIT_RIDES_CREATE_PER_HOUR=20
RATE_LIMIT_REQUESTS_CREATE_PER_HOUR=30

# --- Reverse Proxy (ab Phase 7) ---------------------------------------------
DOMAIN=localhost
# Adresse, an die der API-Port auf dem Host gebunden wird. Standard: nur localhost.
# Proxmox-Zielmaschine (deploy/hel/): die interne Adresse des Gasts, z. B. 10.10.10.80.
API_BIND=127.0.0.1
API_PORT=8000

# --- Backup (ab Phase 7) ----------------------------------------------------
# age-Empfänger (öffentlicher Schlüssel, beginnt mit "age1..."); privater Schlüssel NICHT hier.
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_DAYS=7

# --- Caddy / Cleanup (Phase 7) ----------------------------------------------
# Reverse Proxy nur mit Compose-Profil "proxy" (beide Zeilen gehören zusammen; aktivieren, indem
# man beide einkommentiert; nicht nötig, wenn davor schon ein Rand-Proxy steht, z. B. deploy/hel/):
# COMPOSE_PROFILES=proxy
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# Die zweite Datei entfernt die Port-Veröffentlichung der API und trägt Caddys feste Adresse als
# einzigen vertrauten Proxy ein. Das Docker-Netz "proxy" hat ein festes Subnetz; bei Überschneidung
# mit einem Hostnetz CADDY_SUBNET, CADDY_IPV4 und CADDY_IP_RANGE gemeinsam ändern:
# (CADDY_IPV4 muss im Subnetz, aber NICHT in CADDY_IP_RANGE liegen: daraus vergibt Docker die
# Adressen der übrigen Container.)
# CADDY_SUBNET=172.29.71.0/24
# CADDY_IPV4=172.29.71.2
# CADDY_IP_RANGE=172.29.71.128/25
# Ports von Caddy (Container UND Host). Nicht-Standard-Ports verhindern die Let's-Encrypt-HTTP-Prüfung.
HTTP_PORT=80
HTTPS_PORT=443
# Site-Adresse von Caddy; Standard = DOMAIN. "http://meine.domain" schaltet TLS ab (TLS macht dann
# ein Proxy davor). DOMAIN=localhost -> interne CA (Browser-Warnung).
# CADDY_SITE_ADDRESS=
# Proxys VOR diesem Caddy (Leerzeichen-getrennt, IPs/CIDRs), deren X-Forwarded-For geglaubt wird.
CADDY_TRUSTED_PROXIES=127.0.0.1/32
# Für DOMAIN=localhost-Tests "max-age=0" setzen, damit sich der Browser localhost nicht merkt.
CADDY_HSTS=max-age=31536000
# WICHTIG hinter Caddy: Die API sieht als Peer die Container-Adresse von Caddy. Damit das Rate-Limit
# je Client greift (statt einem gemeinsamen Limit für alle), muss TRUSTED_PROXIES genau diese eine
# Adresse (/32) enthalten - das erledigt docker-compose.proxy.yml. Ohne diese Einstellung zählen ALLE
# Nutzer als ein Client (ein einziger Angreifer sperrt dann alle aus); die API schreibt in diesem
# Fall einmal die Warnung "TRUSTED_PROXIES ist leer" ins Log.
# Der Cleanup-Dienst (alle 6 h) läuft immer mit; einmalig/manuell:  make cleanup  (DRY=1 = nur zählen).
# Das Backup (make backup) braucht BACKUP_AGE_RECIPIENT (oben) und age auf dem Host; BACKUP_KEEP_DAYS
# muss kleiner sein als RETENTION_DAYS_AFTER_EVENT. BACKUP_DIR (Standard ./backups) ist optional.
# BACKUP_DIR=./backups
# Origin-Prüfung der API (Schreibzugriffe): Ohne ALLOWED_ORIGINS gilt nur https://DOMAIN OHNE Port.
# Bei einem Nicht-Standard-HTTPS_PORT, bei CADDY_SITE_ADDRESS=http://... oder im Frontend-Entwicklungs-
# modus (Vite-Dev-Proxy, z. B. http://localhost:5173) liefern POST/PUT/PATCH/DELETE sonst 403 -
# dann ALLOWED_ORIGINS (oben, Abschnitt Auth) exakt setzen, z. B. https://meine.domain:8443
